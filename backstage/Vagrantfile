Vagrant.configure("2") do |config|
  config.vm.box = "rocky9-updated"
  config.vm.hostname = "backstage-rocky9"
  config.vm.network "public_network",
    ip: "192.168.1.48",
    bridge: "WLAN"

  config.vm.provider "vmware_desktop" do |v|
    v.gui = true
    v.vmx["memsize"] = "4096"
    v.vmx["numvcpus"] = "2"
    v.vmx["displayname"] = "backstage-rocky9"
    v.vmx["ethernet0.pcislotnumber"] = "160"
  end

  config.vm.provision "shell", inline: <<-SHELL
    if [ -d /etc/udev/rules.d/70-persistent-net.rules ]; then
      rm -rf /etc/udev/rules.d/70-persistent-net.rules
    fi
  SHELL

  config.vm.provision "shell", inline: <<-SHELL
    set -euo pipefail
    BR_IFACE="$(ip -o -4 addr show | awk 'index($4,"192.168.1.48/")==1{print $2; exit}')"
    if [ -n "${BR_IFACE}" ]; then
      BR_CONN="$(nmcli -t -f NAME,DEVICE con show --active | awk -F: -v dev="${BR_IFACE}" '$2==dev {print $1; exit}')"
      if [ -n "${BR_CONN}" ]; then
        nmcli con mod "${BR_CONN}" ipv4.gateway "192.168.1.1" ipv4.dns "8.8.8.8" ipv4.route-metric 500 ipv4.method manual || true
        nmcli con up "${BR_CONN}" || true
      fi
    fi
  SHELL
  
  config.vm.provision "shell",
    path: "install_backstage.sh",
    env: {
      "BACKSTAGE_URL" => "http://192.168.1.48",
      "BACKSTAGE_HOSTNAME" => "192.168.1.48",
      "BACKSTAGE_PORT" => "3000",
      "BACKSTAGE_BACKEND_PORT" => "7007"
    }

# Primo collegamento:
# 1) Avvio VM:
#    vagrant up --provider=vmware_desktop
# 2) Accesso SSH alla VM:
#    vagrant ssh
# 3) Verifica stato Backstage:
#    curl -s http://192.168.1.48:7007/api/health
# 4) Accesso frontend:
#    http://192.168.1.48:3000
# 5) Accesso backend:
#    http://192.168.1.48:7007
end
