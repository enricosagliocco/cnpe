Vagrant.configure("2") do |config|
  config.vm.box = "rocky9-updated"

  config.vm.provider "vmware_desktop" do |v|
    v.gui = true
    v.vmx["memsize"] = "8192"
    v.vmx["numvcpus"] = "4"
    v.vmx["ethernet0.pcislotnumber"] = "160"
  end

  node_name = "rke2-single"
  node_ip = "192.168.1.21"

  config.vm.define node_name do |machine|
    machine.vm.hostname = node_name
    machine.vm.network "public_network",
      ip: node_ip,
      bridge: "WLAN"

    machine.vm.provider "vmware_desktop" do |v|
      v.vmx["displayname"] = node_name
      v.vmx["memsize"] = "12288"
      v.vmx["numvcpus"] = "4"
    end

    machine.vm.provision "shell", inline: <<-SHELL
      set -euo pipefail
      BR_IFACE="$(ip -o -4 addr show | awk '$4 ~ /^#{node_ip.gsub('.', '\\\\.')}\\// {print $2; exit}')"
      if [ -n "${BR_IFACE}" ]; then
        BR_CONN="$(nmcli -t -f NAME,DEVICE con show --active | awk -F: -v dev="${BR_IFACE}" '$2==dev {print $1; exit}')"
        if [ -n "${BR_CONN}" ]; then
          nmcli con mod "${BR_CONN}" ipv4.gateway "192.168.1.1" ipv4.dns "8.8.8.8" ipv4.route-metric 500 ipv4.method manual || true
          nmcli con up "${BR_CONN}" || true
        fi
      fi
    SHELL

    machine.vm.provision "shell",
      path: "scripts/common_os_prep.sh",
      env: {
        "RKE2_SINGLE_IP" => node_ip,
        "RKE2_SINGLE_NAME" => node_name
      }

    machine.vm.provision "shell",
      path: "scripts/install_rke2_single.sh",
      env: {
        "RKE2_TOKEN" => "rke2-single-secret-token-CambiaMe",
        "RKE2_SINGLE_IP" => node_ip,
        "RKE2_SINGLE_NAME" => node_name
      }

    machine.vm.provision "shell",
      path: "scripts/setup_kubectl_alias.sh",
      run: "always"

    machine.vm.provision "shell",
      path: "scripts/setup_traefik_gateway.sh",
      run: "once"
  end

# Verifiche rapide dopo il provisioning:
# 1) Avvio nodo:
#    vagrant up --provider=vmware_desktop
#
# 2) Accesso al nodo:
#    vagrant ssh rke2-single
#
# 3) Verifica cluster single-node:
#    sudo /var/lib/rancher/rke2/bin/kubectl get nodes -o wide
#    sudo /var/lib/rancher/rke2/bin/kubectl get pods -A
#
# 4) Verifica Traefik Gateway API:
#    sudo /var/lib/rancher/rke2/bin/kubectl get gatewayclass
#    sudo /var/lib/rancher/rke2/bin/kubectl -n kube-system get svc traefik-gateway-nodeport
#
# 5) Test HTTP dal browser host:
#    curl -H 'Host: nginx.example.local' http://192.168.1.21/
end
